<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <title>Artifact Result</title>

</head>

<body>

  <div class="result-page">

    <h1>Artifact Identification</h1>


    <div class="result-container">


      <!-- LEFT: Uploaded image -->

      <div class="artifact-image">

        <h2>Your Artifact</h2>

        <img
          src="<%= artifact.image %>"
          alt="Uploaded artifact"
        >

        <p>
          <strong>State:</strong>
          <%= artifact.state %>
        </p>

        <p>
          <strong>Estimated Length:</strong>
          <%= artifact.estimatedLength %> inches
        </p>

      </div>


      <!-- RIGHT: AI response -->

      <div class="ai-result">

        <h2>AI Identification</h2>

        <div class="identification">

          <pre><%= artifact.identification %></pre>

        </div>

      </div>


    </div>

  </div>

</body>

</html>